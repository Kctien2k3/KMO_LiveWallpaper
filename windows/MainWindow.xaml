<Window x:Class="KMO_LiveWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KMO Live Wallpaper"
        Width="550" Height="730"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1E"
        Foreground="#ECECEC"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI, -apple-system, Arial">
    <Window.Resources>
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#252528" />
            <Setter Property="BorderBrush" Value="#38383C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="16,0,16,12" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style TargetType="Button" x:Key="ModernBtn">
            <Setter Property="Background" Value="#333336" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#4F4F54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton" x:Key="SegmentRadioBtn">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#4CC2FF" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.28" />
                    <Setter Property="Foreground" Value="#666666" />
                    <Setter Property="Cursor" Value="No" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Content Cards -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,14,0,0">

                <!-- Header Brand Card -->
                <Border Style="{StaticResource CardStyle}" Padding="16,10">
                    <DockPanel>
                        <Image x:Name="ImgLogo" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="KMO Live Wallpaper" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />
                            <TextBlock Text="Native Live Wallpaper • Tối ưu phần cứng &amp; Zero-Copy GPU" FontSize="11.5" Foreground="#888888" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- CARD 1: Video & Tuỳ chọn phát -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Text="🎬 Video nền" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                            <Button Content="Chọn..." Width="70" DockPanel.Dock="Right" Style="{StaticResource ModernBtn}" Click="BtnChooseVideo_Click" />
                            <TextBlock x:Name="TxtVideoName" Text="Chưa chọn video" Foreground="#AAAAAA"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </DockPanel>

                        <!-- Khung thông tin kỹ thuật video gốc -->
                        <Border Background="#1C1C1E" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" BorderBrush="#333333" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="THÔNG TIN GỐC TỆP VIDEO" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                                    <TextBlock x:Name="TxtNativeResInfo" Text="Đang nhận diện tệp..." FontSize="12.5" FontWeight="SemiBold" Foreground="#4CC2FF" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="TxtSupportedModesInfo" Text="Khả dụng: 1080p, 2K, 4K"
                                           FontSize="11" Foreground="#32D74B" VerticalAlignment="Center" FontWeight="Medium" />
                            </Grid>
                        </Border>

                        <Separator Background="#333336" Margin="0,4,0,8" />

                        <!-- Lựa chọn độ phân giải phát -->
                        <DockPanel Margin="0,2,0,4">
                            <TextBlock Text="✨ Chất lượng" VerticalAlignment="Center" FontSize="12.5" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="Rb1080p" Content="1080p" GroupName="ResolutionGroup" Style="{StaticResource SegmentRadioBtn}"
                                             Margin="0,0,14,0" VerticalAlignment="Center" Checked="Resolution_Checked" />
                                <RadioButton x:Name="Rb2k" Content="2K QHD" GroupName="ResolutionGroup" Style="{StaticResource SegmentRadioBtn}"
                                             Margin="0,0,14,0" VerticalAlignment="Center" Checked="Resolution_Checked" />
                                <RadioButton x:Name="Rb4k" Content="4K Gốc" GroupName="ResolutionGroup" Style="{StaticResource SegmentRadioBtn}"
                                             IsChecked="True" VerticalAlignment="Center" Checked="Resolution_Checked" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock x:Name="TxtQualityNotice" Text="Đang giải mã gốc (Direct Hardware Scanout) mượt mà nhất cho GPU/CPU"
                                   FontSize="11" Foreground="#4CC2FF" Margin="0,2,0,4" HorizontalAlignment="Right" />

                        <Separator Background="#333336" Margin="0,4,0,8" />

                        <!-- Tốc độ khung hình (FPS Mode) -->
                        <DockPanel Margin="0,2,0,2">
                            <TextBlock Text="⚡ Tốc độ FPS" VerticalAlignment="Center" FontSize="12.5" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="RbFps30" Content="30 FPS" GroupName="FpsGroup" Style="{StaticResource SegmentRadioBtn}"
                                             Margin="0,0,14,0" VerticalAlignment="Center" Checked="Fps_Checked" />
                                <RadioButton x:Name="RbFps60" Content="60 FPS" GroupName="FpsGroup" Style="{StaticResource SegmentRadioBtn}"
                                             IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" Checked="Fps_Checked" />
                                <RadioButton x:Name="RbFps120" Content="120 FPS" GroupName="FpsGroup" Style="{StaticResource SegmentRadioBtn}"
                                             VerticalAlignment="Center" Checked="Fps_Checked" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 2: Khung hình & Màu sắc -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <!-- Phân đoạn phạm vi áp dụng (Scope Segment) -->
                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Text="🎯 Áp dụng cho" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="RbScopeDesktop" Content="🖥️ Màn chính" GroupName="ScopeGroup" Style="{StaticResource SegmentRadioBtn}"
                                             IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" Checked="Scope_Checked" />
                                <RadioButton x:Name="RbScopeLock" Content="🔒 Khóa &amp; Chờ" GroupName="ScopeGroup" Style="{StaticResource SegmentRadioBtn}"
                                             VerticalAlignment="Center" Checked="Scope_Checked" />
                            </StackPanel>
                        </DockPanel>

                        <Separator Background="#333336" Margin="0,4,0,8" />

                        <!-- Chế độ Khung hình + Nút Đặt lại -->
                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Text="📐 Khung hình" VerticalAlignment="Center" FontSize="12.5" />
                            <Button Content="Đặt lại" Width="55" Height="22" Margin="10,0,0,0" Style="{StaticResource ModernBtn}"
                                    FontSize="11" Padding="4,1" Click="BtnReset_Click" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="RbFill" Content="Lấp đầy" GroupName="StretchGroup" Style="{StaticResource SegmentRadioBtn}"
                                             IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" Checked="Stretch_Checked" />
                                <RadioButton x:Name="RbUniform" Content="Vừa khít" GroupName="StretchGroup" Style="{StaticResource SegmentRadioBtn}"
                                             Margin="0,0,12,0" VerticalAlignment="Center" Checked="Stretch_Checked" />
                                <RadioButton x:Name="RbStretch" Content="Kéo giãn" GroupName="StretchGroup" Style="{StaticResource SegmentRadioBtn}"
                                             VerticalAlignment="Center" Checked="Stretch_Checked" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,2,0,6">
                            <TextBlock Text="🔍 Thu phóng" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBlock x:Name="TxtZoomVal" Text="100%" Width="45" TextAlignment="Right" DockPanel.Dock="Right" Foreground="#AAAAAA" />
                            <Slider x:Name="SliderZoom" Minimum="50" Maximum="200" Value="100" Margin="10,0,10,0" ValueChanged="Transform_Changed" />
                        </DockPanel>

                        <DockPanel Margin="0,2,0,6">
                            <TextBlock Text="↔ Dịch ngang" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBlock x:Name="TxtOffsetXVal" Text="0" Width="45" TextAlignment="Right" DockPanel.Dock="Right" Foreground="#AAAAAA" />
                            <Slider x:Name="SliderOffsetX" Minimum="-600" Maximum="600" Value="0" Margin="10,0,10,0" ValueChanged="Transform_Changed" />
                        </DockPanel>

                        <DockPanel Margin="0,2,0,6">
                            <TextBlock Text="↕ Dịch dọc" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBlock x:Name="TxtOffsetYVal" Text="0" Width="45" TextAlignment="Right" DockPanel.Dock="Right" Foreground="#AAAAAA" />
                            <Slider x:Name="SliderOffsetY" Minimum="-500" Maximum="500" Value="0" Margin="10,0,10,0" ValueChanged="Transform_Changed" />
                        </DockPanel>

                        <Separator Background="#333336" Margin="0,4,0,8" />

                        <!-- Bộ lọc màu sắc: Tương phản & Độ rực rỡ -->
                        <DockPanel Margin="0,2,0,6">
                            <TextBlock Text="🌗 Tương phản" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBlock x:Name="TxtContrastVal" Text="100%" Width="45" TextAlignment="Right" DockPanel.Dock="Right" Foreground="#AAAAAA" />
                            <Slider x:Name="SliderContrast" Minimum="80" Maximum="130" Value="100" Margin="10,0,10,0" ValueChanged="ColorSlider_Changed" />
                        </DockPanel>

                        <DockPanel Margin="0,2,0,2">
                            <TextBlock Text="🎨 Độ rực rỡ" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBlock x:Name="TxtSaturationVal" Text="100%" Width="45" TextAlignment="Right" DockPanel.Dock="Right" Foreground="#AAAAAA" />
                            <Slider x:Name="SliderSaturation" Minimum="50" Maximum="150" Value="100" Margin="10,0,10,0" ValueChanged="ColorSlider_Changed" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 3: Màn hình khóa & Screen Saver -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Text="🔒 Chạy trên Màn hình khóa (Lock screen)" VerticalAlignment="Center" FontSize="12.5" />
                            <CheckBox x:Name="CbLockScreen" IsChecked="True" HorizontalAlignment="Right" Checked="CbLockScreen_Changed" Unchecked="CbLockScreen_Changed" />
                        </DockPanel>

                        <Separator Background="#333336" Margin="0,4,0,8" />

                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Text="🌙 Chạy trên Trình bảo vệ màn hình (Screen saver)" VerticalAlignment="Center" FontSize="12.5" />
                            <CheckBox x:Name="CbScreenSaver" IsChecked="True" HorizontalAlignment="Right" Checked="CbScreenSaver_Changed" Unchecked="CbScreenSaver_Changed" />
                        </DockPanel>

                        <Separator Background="#333336" Margin="0,4,0,8" />

                        <DockPanel Margin="0,2,0,2">
                            <TextBlock Text="🔗 Đồng bộ kích cỡ &amp; màu với màn chính" VerticalAlignment="Center" FontSize="12.5" />
                            <CheckBox x:Name="CbSyncLockScreen" IsChecked="True" HorizontalAlignment="Right" Checked="CbSyncLockScreen_Changed" Unchecked="CbSyncLockScreen_Changed" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- CARD 4: Tiết kiệm năng lượng & Mức trần -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Text="🖥️ Tự dừng khi cửa sổ đạt trên 90% màn hình" VerticalAlignment="Center" FontSize="12.5" />
                            <CheckBox x:Name="CbAutoPause90" IsChecked="True" HorizontalAlignment="Right" Checked="CbAutoPause90_Changed" Unchecked="CbAutoPause90_Changed" />
                        </DockPanel>

                        <Separator Background="#333336" Margin="0,4,0,8" />

                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Text="⚡ Trần tối ưu ≤ 5% CPU &amp; 80MB RAM" VerticalAlignment="Center" FontSize="12.5" />
                            <CheckBox x:Name="CbCeiling" IsChecked="True" HorizontalAlignment="Right" Checked="CbCeiling_Changed" Unchecked="CbCeiling_Changed" />
                        </DockPanel>

                        <Separator Background="#333336" Margin="0,4,0,8" />

                        <DockPanel Margin="0,2,0,8">
                            <TextBlock Text="🚀 Tự khởi động khi đăng nhập Windows" VerticalAlignment="Center" FontSize="12.5" />
                            <CheckBox x:Name="CbAutoLaunchStartup" IsChecked="True" HorizontalAlignment="Right" Checked="CbAutoLaunchStartup_Changed" Unchecked="CbAutoLaunchStartup_Changed" />
                        </DockPanel>

                        <Separator Background="#333336" Margin="0,4,0,8" />

                        <DockPanel Margin="0,2,0,2">
                            <TextBlock Text="🔇 Tắt âm thanh video" VerticalAlignment="Center" FontSize="12.5" />
                            <CheckBox x:Name="CbMute" IsChecked="True" HorizontalAlignment="Right" Checked="CbMute_Changed" Unchecked="CbMute_Changed" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Bar -->
        <Border Grid.Row="1" Background="#18181A" BorderBrush="#2D2D30" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Status & Stats -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#4CC2FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtStatus" Text="Đang phát" Foreground="#BBBBBB" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- Row 1: Action Buttons -->
                <UniformGrid Grid.Row="1" Columns="4">
                    <Button x:Name="BtnPlayPause" Content="Tạm dừng" Margin="0,0,4,0" Height="30" Style="{StaticResource ModernBtn}" Click="BtnPlayPause_Click" />
                    <Button Content="Thu nhỏ" Margin="2,0,2,0" Height="30" Style="{StaticResource ModernBtn}" Click="BtnMinimize_Click" />
                    <Button Content="Ẩn khay" Margin="2,0,2,0" Height="30" Style="{StaticResource ModernBtn}" Click="BtnHide_Click" />
                    <Button Content="Thoát" Margin="4,0,0,0" Height="30" Style="{StaticResource ModernBtn}" Background="#3A1C1C" BorderBrush="#5C2626" Click="BtnExit_Click" />
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
